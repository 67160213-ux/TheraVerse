# Copy to .env in the project root — docker-compose reads this automatically.

# --- Postgres ---
POSTGRES_USER=therapeutics
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=therapeutics
POSTGRES_PORT=5432

# --- API ---
API_PORT=4000
# Must match wherever the web container is actually reachable from a browser.
CORS_ORIGIN=http://localhost:8081

# --- Web (frontend) ---
WEB_PORT=8081
# Must match API_PORT above and be reachable from the *browser*, not just
# from inside Docker's network — so localhost, not the "api" service name.
VITE_API_URL=http://localhost:4000/api

# --- Optional tools ---
ADMINER_PORT=8080
