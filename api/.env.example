# Copy to .env for local `npm run dev` (outside Docker).
# Inside docker-compose, these are supplied via the compose file's environment: block instead —
# see .env.docker.example for the variables docker-compose itself reads.

DATABASE_URL="postgresql://therapeutics:therapeutics@localhost:5432/therapeutics?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
